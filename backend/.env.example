# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://postgres:azer@localhost:5433/phantasm
PGSSL=false

# ---- Sessions (admin login) ----
# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Initial admin account (used only by `npm run seed:admin`) ----
ADMIN_EMAIL=rkg6130@gmail.com
ADMIN_PASSWORD=azer124598

# ---- Outgoing email (SMTP) ----
# Works with Gmail (use an App Password), SendGrid, Mailgun, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Phantasm 2026 <no-reply@phantasm.fest>"
# If SMTP_HOST/SMTP_USER/SMTP_PASS are left blank, the server logs emails to
# the console instead of sending them, so the app still runs without a
# mail account configured.

# Public URL of the deployed frontend, used to build links inside emails
# (password reset link, etc).
FRONTEND_URL=http://localhost:5173

# ---- Payments (Cashfree) ----
# Leave blank to run in mock-payment mode: registrations are auto-marked
# PAID immediately, useful for local development / demos without a
# Cashfree merchant account.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
